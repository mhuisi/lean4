@[builtin_fmt Lean.Parser.Module.header]
public def fmtHeader : Fmt := fun
  | `(Parser.Module.header| $[module%$moduleTk?]? $[prelude%$preludeTk?]? $importsStx*) => do
    let «module?» ← fmt? moduleTk?
    let «prelude?» ← fmt? preludeTk?
    let imports := joinUsing hardNl <| ← importsStx.mapM fun
      | `(Parser.Module.import| $[public%$publicTk?]? $[meta%$metaTk?]? import%$importTk $[all%$allTk?]? $mod) => do
        let «public?» ← fmt? publicTk?
        let «meta?» ← fmt? metaTk?
        let «import» ← fmt importTk
        let «all?» ← fmt? allTk?
        let mod ← fmt mod
        return combine #[
          .withSepAfter «public?» space,
          .withSepAfter «meta?» space,
          .withSepAfter «import» space,
          «all?»,
          .withSepBefore mod ⟨nl, maybeFlattened ∘ nested⟩
        ]
      | _ => throw .partialFormatter
    return combine #[
      .withSepAfter «module?» (hardNl ++ hardNl),
      .withSepAfter «prelude?» hardNl,
      imports
    ]
  | _ => throw .partialFormatter

@[builtin_fmt Lean.Parser.Module.module]
public def fmtModule : Fmt := fun stx => do
  let Syntax.node _ ``Parser.Module.module #[
        headerStx,
        Syntax.node _ `Lean.Parser.Module.cmds cmdStxs
      ] := stx
    | throw .partialFormatter
  fmtCommands <| #[headerStx] ++ cmdStxs
where
  fmtCommands (stxs : Array Syntax) : FmtM TaggedDoc := do
    let mut acc? : Option TaggedDoc := none
    for h:i in (0...stxs.size) do
      let stx := stxs[i]
      let (leadingDocs, trailingDocs) ← fmtWhitespace stx
        -- The parser only produces leading whitespace on the first token.
        (fmtCommandLeading (isInitialLeading := true))
        (fmtCommandTrailing (isFinalTrailing := i == stxs.size - 1))
      let mut d ← fmt stx
      if ! leadingDocs.isEmpty then
        d := join leadingDocs ++ d
      if ! trailingDocs.isEmpty then
        d := d ++ join trailingDocs
      match acc? with
      | none =>
        acc? := some d
      | some acc =>
        acc? := some <| acc ++ d
    return acc?.get!
  fmtCommandLeading (leadingTk : Syntax) (leading : Substring.Raw) (isInitialLeading : Bool) : FmtM (Array (TaggedDoc × Option Syntax.Range)) := do
    let some leadingTkRange := leadingTk.getRange?
      | throw <| .malformedInputSyntax leadingTk none "missing token range"
    let some leading := leading.toSlice?
      | throw <| .malformedInputSyntax leadingTk none "substring is invalid and cannot be converted to a slice"
    let comments := parseComments (← read).lineInfos leadingTkRange .leading leading
    let topLevelComments := comments.filter (! ·.placement matches .afterToken)
    let mut docs := fmtComments topLevelComments leading
    if isInitialLeading then
      docs := docs.toList.dropWhile (·.1 matches ⟨.newline none⟩) |>.toArray
    return docs
  fmtCommandTrailing (trailingTk : Syntax) (trailing : Substring.Raw) (isFinalTrailing : Bool) : FmtM (Array (TaggedDoc × Option Syntax.Range)) := do
    let some trailingTkRange := trailingTk.getRange?
      | throw <| .malformedInputSyntax trailingTk none "missing token range"
    let some trailing := trailing.toSlice?
      | throw <| .malformedInputSyntax trailingTk none "substring is invalid and cannot be converted to a slice"
    let comments := parseComments (← read).lineInfos trailingTkRange .trailing trailing
    let topLevelComments := comments.filter (! ·.placement matches .afterToken)
    let mut docs := fmtComments topLevelComments trailing
    if isFinalTrailing then
      docs := docs.popWhile (·.1 matches ⟨.newline none⟩)
    return docs
  fmtComments (comments : Array Comment) (whitespace : String.Slice) : Array (TaggedDoc × Option Syntax.Range) := Id.run do
    let topLevelComments := comments.filter (! ·.placement matches .afterToken)
    let numNewlinesBeforeComments := countNewlinesBeforeComments topLevelComments whitespace
    let mut r := #[]
    let mut insertedAnyNewlines := false
    for h:i in (0...comments.size) do
      if let some numNewlines := numNewlinesBeforeComments.get? i then
        let maxNumNewlines :=
          if i == 0 || comments[i - 1].kind matches .blockComment then
            2
          else
            1
        for _ in (0...Nat.min numNewlines maxNumNewlines) do
          r := r.push (hardNl, none)
          insertedAnyNewlines := true
      let c := comments[i]
      let alternatives := c.render.map (·.rendered) |>.map fun r =>
        let lines := r.split '\n' |>.map (.text ·.toString) |>.toArray
        untagged <| .joinUsing .hardNl lines
      let mut d := oneOf alternatives
      if c.kind matches .lineComment then
        d := d ++ hardNl
        insertedAnyNewlines := true
      r := r.push (d, c.originalWhitespaceRange)
    if let some finalNumNewlines := numNewlinesBeforeComments.get? comments.size then
      let maxNumNewlines :=
        if comments.size == 0 || comments[comments.size - 1]!.kind matches .blockComment then
          2
        else
          1
      for _ in (0...Nat.min finalNumNewlines maxNumNewlines) do
        r := r.push (hardNl, none)
        insertedAnyNewlines := true
    if ! insertedAnyNewlines then
      r := r.push (hardNl, none)
    return r
  countNewlinesBeforeComments (comments : Array Comment) (whitespace : String.Slice) : Std.HashMap Nat Nat := Id.run do
    let searcher := String.Slice.Pattern.ToForwardSearcher.toSearcher '\n' whitespace
    let newlinePositions := searcher.filterMap (fun | .matched startPos _ => some startPos.str.offset | .rejected .. => none)
    let mut newlinesBeforeComment := {}
    let mut i := 0
    for newlinePosition in newlinePositions do
      -- Skip all comments that are strictly before `newlinePosition`.
      while true do
        let some c := comments[i]?
          | break
        if newlinePosition < c.originalWhitespaceRange.stop then
          break
        -- c.originalWhitespaceRange.stop <= newlinePosition
        i := i + 1
      -- The comment at `i` now either contains `newlinePosition` or `newlinePosition` is before it.
      if let some c := comments[i]? then
        if c.originalWhitespaceRange.contains newlinePosition then
          continue
      newlinesBeforeComment := newlinesBeforeComment.alter i fun
        | none => some 1
        | some num => some <| num + 1
    return newlinesBeforeComment

@[builtin_fmt Lean.Parser.Command.docComment]
public def fmtDocComment : Fmt := fmtRaw -- TODO once verso docstrings are fixed

@[builtin_fmt Lean.Parser.Term.attrKind]
public def fmtAttrKind : Fmt := fun
  | `(Parser.Term.attrKind| $[scoped%$scopedTk?]?) => do
    let scopedTk? ← fmt? scopedTk?
    return scopedTk?.getD empty
  | `(Parser.Term.attrKind| $[local%$localTk?]?) => do
    let localTk? ← fmt? localTk?
    return localTk?.getD empty
  | _ => throw .partialFormatter

@[builtin_fmt Lean.Parser.Attr.simple]
public def fmtSimpleAttr : Fmt := fun
  | `(Parser.Attr.simple| $id:ident $[$arg?]?) => do
    let id ← fmt id
    let arg? ← fmt? arg?
    return maybeFlattened <| combine #[
      .withSepAfter id nl,
      arg?
    ]
  | _ => throw .partialFormatter

