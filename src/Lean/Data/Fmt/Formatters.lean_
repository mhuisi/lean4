public def fmtProtected : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Command.meta]
public def fmtMeta : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Command.noncomputable]
public def fmtNoncomputable : Fmt := fmtRaw

public def fmtMetaOrNoncomputable : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Command.unsafe]
public def fmtUnsafe : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Command.partial]
public def fmtPartial : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Command.nonrec]
public def fmtNonrec : Fmt := fmtRaw

public def fmtPartialOrNonrec : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Command.declModifiers]
public def fmtDeclModifiers : Fmt := fun
  | `(declModifiers|
      $[$docComment?:docComment]?
      $[$attributes?:attributes]?
      $[$visibility?:visibility]?
      $[$protected?:protected]?
      $[$metaOrNoncomputable?]?
      $[$unsafe?:unsafe]?
      $[$partialOrNonrec?]?) => do
    let docComment? ← fmt? docComment?
    let attributes? ← fmt? attributes?
    let visibility? ← fmtWith? fmtVisibility visibility?
    let protected? ← fmt? protected?
    let metaOrNoncomputable? ← fmtWith? fmtMetaOrNoncomputable metaOrNoncomputable?
    let unsafe? ← fmt? unsafe?
    let partialOrNonrec? ← fmtWith? fmtPartialOrNonrec partialOrNonrec?
    return combine #[
      .withSepAfter docComment? hardNl,
      .withSepAfter attributes? hardNl,
      .withSepAfter visibility? space,
      .withSepAfter protected? space,
      .withSepAfter metaOrNoncomputable? space,
      .withSepAfter unsafe? space,
      partialOrNonrec?
    ]
  | _ =>
    throw .partialFormatter

public def groupBinders
    (binders : TSyntaxArray [`ident, ``Parser.Term.hole, ``Parser.Term.bracketedBinder])
    : Array (TSyntaxArray [`ident, ``Parser.Term.hole, ``Parser.Term.bracketedBinder]) := Id.run do
  let mut grouped := #[]
  let mut group := #[]
  let mut some groupKind := binders[0]?.map (·.raw.getKind)
    | return #[]
  for binder in binders do
    let kind := binder.raw.getKind
    if kind == groupKind then
      group := group.push binder
    else
      grouped := grouped.push group
      group := #[binder]
      groupKind := kind
  grouped := grouped.push group
  return grouped

@[builtin_fmt Lean.Parser.Term.hole]
public def fmtHole : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Term.binderTactic]
public def fmtBinderTactic : Fmt := fun
  | `(Parser.Term.binderTactic| :=%$colonEqTk by%$byTk $tacticSeq) => do
    let colonEq ← fmt colonEqTk
    let «by» ← fmt byTk
    let tacticSeq ← fmt tacticSeq
    return maybeFlattened <| combine #[
      .withSepAfter colonEq space,
      .withSepAfter «by» nl,
      tacticSeq
    ]
  | _ => throw .partialFormatter

@[builtin_fmt Lean.Parser.Term.binderDefault]
public def fmtDefault : Fmt := fun
  | `(Parser.Term.binderDefault| :=%$colonEqTk $term) => do
    let colonEq ← fmt colonEqTk
    let term ← fmt term
    return maybeFlattened <| combine #[
      .withSepAfter colonEq nl,
      term
    ]
  | _ => throw .partialFormatter

public def fmtBinder
    (ids : TSyntaxArray [`ident, ``Parser.Term.hole])
    (typeAscriptionTk? : Option Syntax)
    (type? : Option (TSyntax `term))
    (tacticOrDefault? : Option (TSyntax [``Parser.Term.binderTactic, ``Parser.Term.binderDefault]))
    : FmtM TaggedDoc := do
  let ids ← ids.mapM fmt
  let ids := fillUsingSpace ids
  let typeAscriptionTk? ← fmt? typeAscriptionTk?
  let type? ← fmt? type?
  let tacticOrDefault? ← fmt? tacticOrDefault?
  let mainBinder := combine #[
    ids,
    .withSepBefore typeAscriptionTk? nl,
    .withSepBefore type? space,
  ]
  let mainBinder :=
    if tacticOrDefault?.isSome then
      hardNested (nested mainBinder)
    else
      nested mainBinder
  return maybeFlattened <| combine #[
    mainBinder,
    .withSepBefore (tacticOrDefault?.map nested) space
  ]

meta def explicitBinderF := Parser.Term.explicitBinder

@[builtin_fmt Lean.Parser.Term.explicitBinder]
public def fmtExplicitBinder : Fmt := fun
  | `(explicitBinderF| (%$lbTk $ids* $[:%$typeAscriptionTk? $type?:term]? $[$tacticOrDefault?]? )%$rbTk) => do
    let lb ← fmt lbTk
    let binder ← fmtBinder ids typeAscriptionTk? type? tacticOrDefault?
    let rb ← fmt rbTk
    return maybeFlattened <| combine #[
      lb,
      binder,
      rb
    ]
  | _ => throw .partialFormatter

meta def implicitBinderF := Parser.Term.implicitBinder

@[builtin_fmt Lean.Parser.Term.implicitBinder]
public def fmtImplicitBinder : Fmt := fun
  | `(implicitBinderF| {%$lbTk $ids* $[:%$typeAscriptionTk? $type?:term]? }%$rbTk) => do
    let lb ← fmt lbTk
    let binder ← fmtBinder ids typeAscriptionTk? type? none
    let rb ← fmt rbTk
    return maybeFlattened <| combine #[
      lb,
      binder,
      rb
    ]
  | _ => throw .partialFormatter

meta def strictImplicitBinderF := Parser.Term.strictImplicitBinder

@[builtin_fmt Lean.Parser.Term.strictImplicitBinder]
public def fmtStrictImplicitBinder : Fmt := fun
  | `(strictImplicitBinderF| {%$lbTk1 {%$lbTk2 $ids* $[:%$typeAscriptionTk? $type?:term]? }%$rbTk1 }%$rbTk2) => do
    let lb1 ← fmt lbTk1
    let lb2 ← fmt lbTk2
    let rb1 ← fmt rbTk1
    let rb2 ← fmt rbTk2
    aux (lb1 ++ lb2) ids typeAscriptionTk? type? (rb1 ++ rb2)
  | `(strictImplicitBinderF| {%$lbTk1 {%$lbTk2 $ids* $[:%$typeAscriptionTk? $type?:term]? ⦄%$rbTk) => do
    let lb1 ← fmt lbTk1
    let lb2 ← fmt lbTk2
    let rb ← fmt rbTk
    aux (lb1 ++ lb2) ids typeAscriptionTk? type? rb
  | `(strictImplicitBinderF| ⦃%$lbTk $ids* $[:%$typeAscriptionTk? $type?:term]? }%$rbTk1 }%$rbTk2) => do
    let lb ← fmt lbTk
    let rb1 ← fmt rbTk1
    let rb2 ← fmt rbTk2
    aux lb ids typeAscriptionTk? type? (rb1 ++ rb2)
  | `(strictImplicitBinderF| ⦃%$lbTk $ids* $[:%$typeAscriptionTk? $type?:term]? ⦄%$rbTk) => do
    let lb ← fmt lbTk
    let rb ← fmt rbTk
    aux lb ids typeAscriptionTk? type? rb
  | _ => throw .partialFormatter
where
  aux lb ids typeAscriptionTk? type? rb : FmtM TaggedDoc := do
    let binder ← fmtBinder ids typeAscriptionTk? type? none
    return maybeFlattened <| combine #[
      lb,
      binder,
      rb
    ]

@[builtin_fmt Lean.Parser.Term.instBinder]
public def fmtInstBinder : Fmt := fun
  | `(Parser.Term.instBinder| [%$lbTk $[$id?:ident :%$typeAscriptionTk?]? $classType:term ]%$rbTk) => do
    let lb ← fmt lbTk
    let id? ← fmt? id?
    let typeAscriptionTk? ← fmt? typeAscriptionTk?
    let classType ← fmt classType
    let rb ← fmt rbTk
    return maybeFlattened <| combine #[
      lb,
      .withSepAfter id? ⟨nl, nested⟩,
      .withSepAfter typeAscriptionTk? space,
      classType,
      rb
    ]
  | _ =>
    throw .partialFormatter

public def fmtBinderGroup
    (binderGroup : TSyntaxArray [`ident, ``Parser.Term.hole, ``Parser.Term.bracketedBinder])
    : FmtM TaggedDoc := do
  let binderGroup ← binderGroup.mapM fmt
  return fillUsingSpace binderGroup

public def fmtBinders
    (binders : TSyntaxArray [`ident, ``Parser.Term.hole, ``Parser.Term.bracketedBinder])
    : FmtM TaggedDoc := do
  let binderGroups := groupBinders binders
  let binderGroups ← binderGroups.mapM fmtBinderGroup
  return joinUsing nl binderGroups

public def fmtSignature
    (lval? : Option Syntax)
    (binders : TSyntaxArray [`ident, ``Parser.Term.hole, ``Parser.Term.bracketedBinder])
    (typeAscriptionTk? : Option Syntax)
    (type? : Option (TSyntax `term))
    : FmtM TaggedDoc := do
  let lval? ← fmt? lval?
  let binders ← fmtBinders binders
  let typeAscriptionTk? ← fmt? typeAscriptionTk?
  let type? ← fmt? type?
  return hardNested <| nested <| oneOf #[
    flattened (
      combine #[
        .withSepAfter lval? space,
        .withSepAfter binders space,
        .withSepAfter typeAscriptionTk? space,
        .withSepAfter type? space,
      ]
    ),
    combine #[
      .withSepAfter (lval?.map flattened) space,
      flattened binders,
      .withSepBefore typeAscriptionTk? nl,
      .withSepBefore type? space,
    ],
    combine #[
      .withSepAfter lval? nl,
      binders,
      .withSepBefore typeAscriptionTk? nl,
      .withSepBefore type? space,
    ]
  ]

@[builtin_fmt Lean.Parser.Termination.terminationBy?]
public def fmtTerminationBy? : Fmt := fmtRaw

@[builtin_fmt Lean.Parser.Termination.terminationBy]
public def fmtTerminationBy : Fmt := fun
  | `(Parser.Termination.terminationBy|
      termination_by%$terminationByTk $[structural%$structuralTk?]? $[$ids?* =>%$arrowTk?]?
        $measure:term) => do
    let terminationBy ← fmt terminationByTk
    let structural? ← fmt? structuralTk?
    let ids? ← ids?.mapM fun ids => do
      return hardNested <| nested <| fillUsingSpace (← fmtArray ids)
    let arrow? ← fmt? arrowTk?
    let measure ← fmt measure
    return maybeFlattened <| combine #[
      terminationBy,
      .withSepBefore structural? space,
      .withSepBefore ids? space,
      .withSepBefore arrow? space,
      .withSepBefore measure ⟨nl, nested⟩
    ]
  | _ => throw .partialFormatter

@[builtin_fmt Lean.Parser.Termination.partialFixpoint]
public def fmtPartialFixpoint : Fmt := fun
  | `(Parser.Termination.partialFixpoint|
      partial_fixpoint%$partialFixpointTk $[monotonicity%$monotonicityTk? $proof?:term]?) => do
    let partialFixpoint ← fmt partialFixpointTk
    let monotonicity? ← fmt? monotonicityTk?
    let proof? ← fmt? proof?
    return combine #[
      .withSepAfter partialFixpoint space,
      .withSepAfter monotonicity? space,
      proof?.map nested
    ]
  | _ =>
    throw .partialFormatter

